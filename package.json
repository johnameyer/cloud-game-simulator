{
  "name": "@cards-ts/lambda-simulator",
  "version": "0.0.1",
  "private": true,
  "description": "Fans out Pokemon Pocket TCG deck simulations across AWS Lambda, orchestrated by Step Functions.",
  "author": "John Meyer",
  "license": "MIT",
  "packageManager": "pnpm@10.30.0",
  "type": "module",
  "directories": {
    "lib": "dist",
    "test": "spec"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint '**/*.ts' --fix",
    "build": "tsc",
    "clean": "rm -rf dist cdk.out tsconfig.tsbuildinfo",
    "test": "pnpm tsc --project tsconfig.spec.json && mocha --recursive ./spec --extension spec.ts",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "diff": "cdk diff"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@cards-ts/pocket-tcg": "file:../pocket-tcg",
    "@cards-ts/pocket-tcg-deck-simulations": "file:../deck-simulations",
    "@cards-ts/pokemon-pocket-tcg-data": "file:../game-data"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^2.13.0",
    "@types/aws-lambda": "^8.10.146",
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "aws-cdk": "^2.170.0",
    "aws-cdk-lib": "^2.170.0",
    "chai": "^5.3.3",
    "constructs": "^10.4.2",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^17.3.0",
    "mocha": "^10.8.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.54.0"
  },
  "sideEffects": false,
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
